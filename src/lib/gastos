/* -------------------------------------------------------------- escritura */

/* Pura y exportada aparte de cargarGasto: es plata real, tiene tests.
   `monto_base` es el gasto llevado a NZD; `deuda` es lo que le toca al otro.
   El servidor recalcula ambos al insertar — esto es solo para pintar la fila
   antes de que la red conteste (y para lo que queda en la cola offline). */
export function calcularMontos(gasto) {
  const base = +(Number(gasto.monto) * (Number(gasto.tc_a_base) || 1)).toFixed(2);
  const deuda =
    gasto.split === "mitad" ? +(base / 2).toFixed(2)
    : gasto.split === "propio" ? 0
    : Number(gasto.monto_exacto || 0);
  return { monto_base: base, deuda };
}

export async function cargarGasto(gasto) {
  const optimista = {
    ...gasto,
    id: gasto.id || `tmp-${crypto.randomUUID()}`,
    creado: new Date().toISOString(),
    ...calcularMontos(gasto),
    pendiente: true,
  };

  try {
    const { pendiente, id, monto_base, deuda, creado, ...limpio } = optimista;
    const { data, error } = await supabase.from("gastos").insert(limpio).select().single();
    if (error) throw error;
    return { fila: data, pendiente: false };
  } catch (e) {
    guardarCola([...leerCola(), optimista]);
    return { fila: optimista, pendiente: true };
  }
}

/* Gastos fijos: los que están marcados como recurrentes y todavía no
   aparecen en el mes pedido. Se comparan por descripción+rubro, que es lo
   que identifica al gasto fijo aunque cambie el monto (un alquiler que
   aumenta sigue siendo el mismo alquiler). */
export async function recurrentesFaltantes(grupo_id, { desde, hasta }) {
  const [{ data: fijos, error: e1 }, { data: delMes, error: e2 }] = await Promise.all([
    supabase.from("gastos").select("*").eq("grupo_id", grupo_id).eq("recurrente", true)
      .order("fecha", { ascending: false }),
    supabase.from("gastos").select("descripcion, rubro").eq("grupo_id", grupo_id)
      .gte("fecha", desde).lte("fecha", hasta),
  ]);
  if (e1) throw e1;
  if (e2) throw e2;

  const clave = (g) => `${g.descripcion}|${g.rubro}`;
  const yaEstan = new Set((delMes || []).map(clave));

  // Un fijo puede tener muchas ocurrencias viejas: nos quedamos con la última
  const vistos = new Set();
  return (fijos || []).filter((g) => {
    const k = clave(g);
    if (vistos.has(k) || yaEstan.has(k)) return false;
    vistos.add(k);
    return true;
  });
}

export async function cargarRecurrentes(faltantes, fecha) {
  const filas = faltantes.map((g) => ({
    grupo_id: g.grupo_id,
    fecha,
    descripcion: g.descripcion,
    rubro: g.rubro,
    monto: g.monto,
    moneda: g.moneda,
    tc_a_base: g.tc_a_base,
    pagador_id: g.pagador_id,
    split: g.split,
    monto_exacto: g.monto_exacto,
    recurrente: true,
  }));
  const { data, error } = await supabase.from("gastos").insert(filas).select();
  if (error) throw error;
  return data;
}

export async function actualizarGasto(id, cambios) {
  const { data, error } = await supabase
    .from("gastos").update(cambios).eq("id", id).select().single();
  if (error) throw error;
  return data;
}

export async function borrarGasto(id) {
  if (String(id).startsWith("tmp-")) {
    guardarCola(leerCola().filter((g) => g.id !== id));
    return;
  }
  const { error } = await supabase.from("gastos").delete().eq("id", id);
  if (error) throw error;
}

/* ------------------------------------------------------------- recibos */

export async function subirRecibo(grupo_id, gasto_id, archivo) {
  const path = `${grupo_id}/${gasto_id}-${Date.now()}.jpg`;
  const { error } = await supabase.storage.from("recibos").upload(path, archivo, { upsert: true });
  if (error) throw error;
  return path;
}

export async function urlRecibo(path) {
  const { data, error } = await supabase.storage.from("recibos").createSignedUrl(path, 3600);
  if (error) throw error;
  return data.signedUrl;
}

export async function saldarCuentas({ grupo_id, de_id, a_id, monto, moneda = "NZD", tc_a_base = 1 }) {
  const { data, error } = await supabase
    .from("pagos")
    .insert({ grupo_id, de_id, a_id, monto, moneda, tc_a_base })
    .select()
    .single();
  if (error) throw error;
  return data;
}

export async function sincronizarCola() {
  const cola = leerCola();
  if (!cola.length) return { enviados: 0, restantes: 0 };

  const quedan = [];
  let enviados = 0;

  for (const fila of cola) {
    try {
      const { pendiente, id, monto_base, deuda, creado, ...limpio } = fila;
      const { error } = await supabase.from("gastos").insert(limpio);
      if (error) throw error;
      enviados++;
    } catch {
      quedan.push(fila);
    }
  }
  guardarCola(quedan);
  return { enviados, restantes: quedan.length };
}

/* --------------------------------------------------------------- realtime */

export function escucharCambios(grupo_id, alCambiar) {
  const canal = supabase
    .channel(`grupo-${grupo_id}`)
    .on("postgres_changes",
      { event: "*", schema: "public", table: "gastos", filter: `grupo_id=eq.${grupo_id}` },
      alCambiar)
    .on("postgres_changes",
      { event: "*", schema: "public", table: "pagos", filter: `grupo_id=eq.${grupo_id}` },
      alCambiar)
    .subscribe();

  return () => supabase.removeChannel(canal);
}

/* ----------------------------------------------------------------- rubros */

/* Orden y valores validados con el script de accesibilidad del skill dataviz:
   pasan banda de luminosidad, chroma, separación para daltonismo y contraste.
   Si se reordenan o se cambia un color hay que volver a validarlos. */
/* Lista default: se usa como semilla en la migración 0007 y como respaldo
   si `rubros` todavía no cargó (o la migración no corrió) — la app nunca
   se queda sin categorías para mostrar. La lista real y editable por grupo
   vive en la tabla `rubros` (ver traerRubros más abajo). */
export const RUBROS = [
  { id: "casa", nombre: "Casa", color: "#00997F" },
  { id: "comida", nombre: "Comida", color: "#C43D4B" },
  { id: "estudio", nombre: "Estudio", color: "#2D62C4" },
  { id: "tramites", nombre: "Trámites", color: "#A87200" },
  { id: "salidas", nombre: "Salidas", color: "#8B3FBF" },
  { id: "transporte", nombre: "Transporte", color: "#0092B0" },
  { id: "setup", nombre: "Setup", color: "#C2186B" },
  { id: "otros", nombre: "Otros", color: "#5E7A18" },
];

export const rubroDe = (id, rubros = RUBROS) =>
  rubros.find((r) => r.id === id) || rubros[rubros.length - 1] || RUBROS[RUBROS.length - 1];

export async function traerRubros(grupo_id) {
  const { data, error } = await supabase
    .from("rubros")
    .select("clave, nombre, color, orden")
    .eq("grupo_id", grupo_id)
    .order("orden", { ascending: true });
  if (error) throw error;
  return (data || []).map((r) => ({ id: r.clave, nombre: r.nombre, color: r.color }));
}

const claveDe = (nombre) =>
  sinAcentos(nombre).replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "") || `rubro-${Date.now()}`;

export async function crearRubro(grupo_id, { nombre, color, orden = 0 }) {
  const clave = claveDe(nombre);
  const { error } = await supabase.from("rubros").insert({ grupo_id, clave, nombre, color, orden });
  if (error) throw error;
  return { id: clave, nombre, color };
}

export async function editarRubro(grupo_id, clave, cambios) {
  const { error } = await supabase.from("rubros").update(cambios)
    .eq("grupo_id", grupo_id).eq("clave", clave);
  if (error) throw error;
}

export async function borrarRubro(grupo_id, clave) {
  const { error } = await supabase.from("rubros").delete()
    .eq("grupo_id", grupo_id).eq("clave", clave);
  if (error) throw error;
}

/* ------------------------------------------------------------- monedas */

/* Tasas fijas de referencia, tomadas el 21-22/08/2026 (blue venta ~$1550
   ARS/USD). No se actualizan en vivo — son un punto de partida editable
   a mano en el formulario. Base = NZD. */
export const TASAS = { NZD: 1, USD: 1.6717, AUD: 1.1907, ARS: 0.0010785 };
export const tasaDe = (moneda) => TASAS[moneda] ?? 1;