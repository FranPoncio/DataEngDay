  { id: "comida", nombre: "Comida", color: "#C43D4B" },
  { id: "estudio", nombre: "Estudio", color: "#2D62C4" },
  { id: "tramites", nombre: "Trámites", color: "#A87200" },
  { id: "salidas", nombre: "Salidas", color: "#8B3FBF" },
  { id: "transporte", nombre: "Transporte", color: "#0092B0" },
  { id: "setup", nombre: "Setup", color: "#C2186B" },
  { id: "otros", nombre: "Otros", color: "#5E7A18" },
];

export const rubroDe = (id) => RUBROS.find((r) => r.id === id) || RUBROS[RUBROS.length - 1];

/* ------------------------------------------------------------- monedas */

/* Tasas fijas de referencia, tomadas el 21-22/08/2026 (blue venta ~$1550
   ARS/USD). No se actualizan en vivo — son un punto de partida editable
   a mano en el formulario. Base = NZD. */
export const TASAS = { NZD: 1, USD: 1.6717, AUD: 1.1907, ARS: 0.0010785 };
export const tasaDe = (moneda) => TASAS[moneda] ?? 1;